[Unit]
Description=AirRadar Pro Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/airradar-pro/backend
Environment=AIRRADAR_DB=/opt/airradar-pro/backend/data/airradar.db
Environment=AIRRADAR_FRONTEND=/opt/airradar-pro/frontend/dist
ExecStart=/opt/airradar-pro/venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8090 wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
